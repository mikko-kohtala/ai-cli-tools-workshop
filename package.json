{
  "name": "ai-cli-tools-workshop",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "type": "module",
  "scripts": {
    "initialize": "bun install && bun scripts/initialize.ts",
    "dev": "bun install && turbo dev",
    "build": "turbo build",
    "lint": "oxlint",
    "format": "oxfmt -c .oxfmtrc.jsonc .",
    "typecheck": "turbo typecheck",
    "check": "bun run lint && bun run format:check && turbo typecheck",
    "clean": "turbo clean && rm -rf node_modules .turbo",
    "copy-curriculum": "bun scripts/copy-curriculum.ts",
    "lint:fix": "oxlint --fix",
    "format:check": "oxfmt -c .oxfmtrc.jsonc --check .",
    "fix": "bun run lint:fix && bun run format"
  },
  "devDependencies": {
    "chalk": "5.6.2",
    "oxfmt": "0.76.0",
    "oxlint": "1.91.0",
    "turbo": "2.6.3",
    "typescript": "5.9.3",
    "zx": "8.8.5"
  },
  "engines": {
    "node": ">=22"
  },
  "packageManager": "bun@1.4.4"
}
