{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["react", "nextjs", "jsx-a11y", "import", "promise", "unicorn", "typescript", "oxc"],
  "rules": {
    "react-hooks/rules-of-hooks": "error",
    "react-hooks/exhaustive-deps": "warn"
  },
  "ignorePatterns": [
    "**/convex/_generated/**",
    "**/.next/**",
    "**/dist/**",
    "**/build/**",
    "**/out/**",
    "workspace/**",
    "**/next-env.d.ts"
  ]
}
